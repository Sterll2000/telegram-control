# Required for production Telegram Mini App authentication
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
INITIAL_ADMIN_TELEGRAM_ID=
SESSION_SECRET=

# Set true only for local demo development. NEVER enable in production.
DEMO_MODE=false

# Optional Supabase/PostgreSQL production connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
NEXT_PUBLIC_APP_NAME=Telegram Control
NEXT_PUBLIC_APP_URL=

NEXT_PUBLIC_DEMO_MODE=false

# Iris monitoring (production; browser demo uses /api/admins POST)
ADMIN_SYNC_SECRET=
IRIS_USERNAME=
IRIS_API_ID=
IRIS_API_HASH=
IRIS_SESSION=
IRIS_CHAT_BLACK=
IRIS_CHAT_BLUE=
IRIS_SCAN_LIMIT=500
IRIS_POLL_MS=1000
IRIS_AUTO_REQUEST_ENABLED=false

# Optional command bot: chat IDs where the bot should answer «кто админ»
CONTROL_BOT_BLACK_CHAT_IDS=
CONTROL_BOT_BLUE_CHAT_IDS=

# Автоматизация Iris через Telegram Bot API + MTProto reader
# Бот должен находиться в обоих чатах и иметь возможность отправлять сообщения.
IRIS_AUTO_REQUEST_INTERVAL_MS=900000
# Telegram ID пользователя, которому бот присылает новые заявки на AFK
AFK_NOTIFY_TELEGRAM_ID=

# Download current Telegram profile photos for admins during Iris sync
IRIS_AVATAR_SYNC=true
