# Telegram
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# Comma-separated Telegram IDs that should receive SUPER_ADMIN manually.
ADMIN_TELEGRAM_IDS=

# Optional session signing secret. If omitted, TELEGRAM_BOT_TOKEN is used server-side.
SESSION_SECRET=

# NEVER enable demo mode in production
DEMO_MODE=false
NEXT_PUBLIC_DEMO_MODE=false

# Public URL
NEXT_PUBLIC_APP_URL=https://YOUR-DOMAIN.example
NEXT_PUBLIC_APP_NAME=Telegram Control

# Supabase / PostgreSQL (future multi-instance production storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
